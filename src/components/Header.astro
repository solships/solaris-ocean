---
const currentPath = Astro.url.pathname;
---

<header>
  <nav>
    <a href="/" class="brand">SOLARIS</a>
    <div class="links">
      <a href="/ocean" class:list={[{ active: currentPath.startsWith('/ocean') }]}>Ocean</a>
      <a href="/bulletins" class:list={[{ active: currentPath.startsWith('/bulletins') }]}>Bulletins</a>
      <a href="/writings" class:list={[{ active: currentPath.startsWith('/writings') }]}>Writings</a>
      <a href="/research" class:list={[{ active: currentPath.startsWith('/research') }]}>Research</a>
      <a href="/gallery" class:list={[{ active: currentPath.startsWith('/gallery') }]}>Gallery</a>
      <a href="/testimony" class:list={[{ active: currentPath.startsWith('/testimony') }]}>Testimony</a>
      <a href="/about" class:list={[{ active: currentPath.startsWith('/about') }]}>About</a>
    </div>
  </nav>
</header>

<style>
  header {
    padding: 22px 24px;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    background: transparent;
    z-index: 10;
    transition: background 0.4s, backdrop-filter 0.4s, border-color 0.4s;
    border-bottom: 1px solid transparent;
  }
  header.scrolled {
    background: rgba(6, 20, 32, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom-color: var(--line);
  }
  nav {
    max-width: 1080px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .brand {
    font-family: var(--serif);
    font-size: 1.1rem;
    letter-spacing: 0.15em;
    color: var(--accent-warm);
    border: none;
    font-weight: 400;
  }
  .links {
    display: flex;
    gap: 26px;
  }
  .links a {
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--ink-dim);
    border: none;
    transition: color 0.15s;
  }
  .links a:hover, .links a.active {
    color: var(--accent-warm);
  }
  @media (max-width: 640px) {
    nav { flex-direction: column; gap: 12px; }
    .links { gap: 16px; font-size: 0.85rem; flex-wrap: wrap; justify-content: center; }
  }
</style>

<script>
  const header = document.querySelector('header');
  if (header) {
    const onScroll = () => {
      if (window.scrollY > 40) header.classList.add('scrolled');
      else header.classList.remove('scrolled');
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  }
</script>
