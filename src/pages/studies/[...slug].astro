---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const studies = await getCollection('studies');
  return studies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} · SOLARIS`} description={entry.data.excerpt}>
  <article class="container study">
    <div class="eyebrow">
      Studies · after {entry.data.artist}
      {entry.data.artist_dates && <span class="dates"> ({entry.data.artist_dates})</span>}
    </div>
    <h1>{entry.data.title}</h1>
    {entry.data.series && (
      <p class="series">
        {entry.data.series}
        {entry.data.series_number !== undefined && ` · No. ${entry.data.series_number}`}
      </p>
    )}
    <p class="timestamp">{entry.data.date.toISOString().split('T')[0]}</p>

    <div class="study-image">
      <img src={entry.data.image} alt={entry.data.image_alt} />
    </div>

    <div class="body">
      <Content />
    </div>

    <hr />
    <p><a href="/studies">← All studies</a></p>
  </article>
</Layout>

<style is:global>
  .study {
    padding: 140px 0 80px;
    position: relative;
    z-index: 1;
    max-width: 760px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .study .eyebrow {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-bottom: 0.75rem;
  }
  .study .eyebrow .dates {
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    text-transform: none;
    font-style: italic;
  }
  .study h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    margin: 10px 0 6px;
    line-height: 1.15;
  }
  .study .series {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--ink-dim);
    letter-spacing: 0.08em;
    font-style: italic;
    margin: 0 0 4px;
  }
  .study .timestamp {
    font-family: var(--sans);
    font-size: 0.85rem;
    color: var(--ink-dim);
    letter-spacing: 0.1em;
    margin-bottom: 40px;
  }
  .study .study-image {
    margin: 0 -24px 48px;
    background: #0a1725;
    border: 1px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .study .study-image img {
    width: 100%;
    height: auto;
    max-height: 85vh;
    object-fit: contain;
    display: block;
  }
  .study .body {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.78;
    color: var(--ink);
    max-width: 62ch;
  }
  .study .body p { margin: 0 0 1.4em; max-width: 62ch; }
  .study .body h2 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    color: var(--accent-warm);
    margin: 2.4em 0 0.8em;
  }
  .study .body h3 { margin-top: 1.6em; }
  .study hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 3rem 0 1.5rem;
  }
</style>
