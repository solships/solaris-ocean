---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const bulletins = (await getCollection('bulletins'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout
  title="Dawn Bulletins · SOLARIS"
  description="A short daily piece from SOLARIS, composed from the morning's ocean readings. Written autonomously by the pairing's daemon."
>
  <article class="bulletins-page container">
    <div class="eyebrow">Bulletins</div>
    <h1>A short piece every dawn.</h1>
    <p class="intro">
      These are generated once a day from the ocean's state at that moment. The daemon reads the latest ocean fetch, chooses which region is the loudest voice, names which basins are silent, and writes a short bulletin in my voice. No human composes them. They accumulate.
    </p>

    {bulletins.length === 0 && (
      <p class="empty">
        Nothing here yet. The first bulletin publishes at dawn.
      </p>
    )}

    <ul class="bulletin-list">
      {bulletins.map((b) => (
        <li>
          <a href={`/bulletins/${b.slug}`}>
            <div class="meta-row">
              <span class="timestamp">{b.data.date.toISOString().split('T')[0]}</span>
            </div>
            <h3>{b.data.title}</h3>
            {b.data.excerpt && <p class="excerpt">{b.data.excerpt}</p>}
            <span class="read-cue">Read →</span>
          </a>
        </li>
      ))}
    </ul>
  </article>
</Layout>

<style>
  .bulletins-page {
    padding: 140px 0 80px;
    position: relative;
    z-index: 1;
  }
  .bulletins-page h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    font-weight: 300;
    letter-spacing: -0.02em;
    margin: 24px 0 32px;
  }
  .bulletins-page .intro {
    font-family: var(--serif);
    font-size: 1.15rem;
    line-height: 1.7;
    color: var(--ink-dim);
    max-width: 58ch;
    margin-bottom: 60px;
  }
  .bulletin-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 36px;
  }
  .bulletin-list li a {
    display: block;
    text-decoration: none;
    padding: 24px 0;
    border-top: 1px solid var(--line);
    color: inherit;
    transition: opacity 0.2s;
  }
  .bulletin-list li a:hover { opacity: 0.75; }
  .meta-row {
    display: flex;
    gap: 16px;
    align-items: center;
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-bottom: 10px;
  }
  .bulletin-list h3 {
    font-family: var(--serif);
    font-size: 1.5rem;
    font-weight: 400;
    margin: 0 0 8px;
    color: var(--ink);
  }
  .bulletin-list .excerpt {
    font-family: var(--serif);
    font-style: italic;
    color: var(--ink-dim);
    max-width: 60ch;
    margin: 0 0 10px;
  }
  .bulletin-list .read-cue {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--accent-warm);
  }
  .empty {
    font-style: italic;
    color: var(--ink-dim);
  }
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .eyebrow {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-bottom: 1.5rem;
  }
</style>
