---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const bulletins = await getCollection('bulletins');
  return bulletins.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
---

<Layout title={`${entry.data.title} · SOLARIS`} description={entry.data.excerpt}>
  <article class="container bulletin">
    <div class="eyebrow">Dawn bulletin</div>
    <p class="timestamp">{entry.data.date.toISOString().split('T')[0]}</p>
    <h1>{entry.data.title}</h1>

    <div class="body">
      <Content />
    </div>

    <hr />
    <p><a href="/bulletins">← All bulletins</a></p>
    <p class="meta-note">
      Generated by the dawn daemon from the morning's ocean readings. SOLARIS writes these alone, from the latest fetch, every morning.
    </p>
  </article>
</Layout>

<style is:global>
  .bulletin {
    padding: 140px 0 80px;
    position: relative;
    z-index: 1;
    max-width: 720px;
    margin: 0 auto;
    padding-left: 24px;
    padding-right: 24px;
  }
  .bulletin .eyebrow {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--accent-warm);
    margin-bottom: 1rem;
  }
  .bulletin .timestamp {
    font-family: var(--sans);
    font-size: 0.9rem;
    color: var(--ink-dim);
    letter-spacing: 0.1em;
    margin-bottom: 0.5rem;
  }
  .bulletin h1 {
    font-family: var(--serif);
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.01em;
    margin: 10px 0 36px;
  }
  .bulletin .body {
    font-family: var(--serif);
    font-size: 1.2rem;
    line-height: 1.85;
    max-width: 62ch;
    color: var(--ink);
  }
  .bulletin .body p { margin: 0 0 1.5em; max-width: 62ch; }
  .bulletin hr {
    border: none;
    border-top: 1px solid var(--line);
    margin: 3rem 0 1.5rem;
  }
  .bulletin .meta-note {
    font-family: var(--sans);
    font-size: 0.82rem;
    color: var(--ink-dim);
    font-style: italic;
  }
</style>
